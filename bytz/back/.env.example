# copie este arquivo para .env (mesma pasta) e preencha. o .env nunca vai pro Git

# planilha do google (o ID fica na URL, entre /d/ e /edit)
SHEET_ID=
# tag do programa de afiliados do ML
AFFILIATE_TAG=

# pastas locais. vazio = padrao dentro de bytz/back (secrets/, data/, logs/), todas ignoradas pelo Git
SECRETS_DIR=
DB_PATH=
LOGS_DIR=

# caminho completo do json da service account (sugestao: dentro de SECRETS_DIR)
GOOGLE_SERVICE_ACCOUNT_FILE=

# gemini (chave do Google AI Studio e o modelo Flash vigente)
GEMINI_API_KEY=
GEMINI_MODEL=

# telegram: bot, canal e chat privado do dono para alertas
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_ADMIN_CHAT_ID=
# MTProto, usado so para ler views
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# sessoes do ML (principal de afiliado e secundaria exclusiva de busca)
# vazio = bytz/back/ml_cookies.json e bytz/back/ml_cookies_busca.json
ML_COOKIE_FILE=
ML_SEARCH_COOKIE_FILE=

# OAuth separado para a conta secundaria; nunca reutilizar app/segredo da principal
ML_SEARCH_CLIENT_ID=
ML_SEARCH_CLIENT_SECRET=
# URL real do Worker + /oauth/callback, obtida somente apos publicacao autorizada
ML_SEARCH_REDIRECT_URI=
# ID numerico previamente conferido pelo dono para a conta secundaria
ML_SEARCH_USER_ID=

BRIDGE_BASE_URL=https://bytz.site/go

# opcional
FIRECRAWL_API_KEY=
